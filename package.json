{
  "name": "masterclass-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n WEB,API -c blue,green \"vite --host 0.0.0.0 --open\" \"npm:server\"",
    "dev": "vite --host 0.0.0.0",
    "server": "json-server --watch data/db.json --port 3001",
    "server:prod": "test -f data/db.json || cp db.seed.json data/db.json; json-server --watch data/db.json --host 0.0.0.0 --port ${PORT:-3001}",
    "dev:all": "concurrently -n WEB,API -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "json-server": "^1.0.0-beta.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  }
}
