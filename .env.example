# PostgreSQL ma'lumotlar bazasi URL (Render PostgreSQL)
# Render Dashboard -> Database -> Connections -> External Database URL (lokal uchun)
# yoki Internal Database URL (Render Web Service ichida)
# Bo'sh qoldirilsa, server avtomatik lokal data/db.json rejimida ishlaydi.
DATABASE_URL=

# Frontend uchun API manzili (oxirida slesh / belgisisiz)
VITE_API_URL=http://localhost:3001

# Click merchant settings. Keep private credentials on the server only.
VITE_CLICK_SERVICE_ID=
VITE_CLICK_MERCHANT_ID=
VITE_CLICK_AMOUNT=
VITE_CLICK_RETURN_URL=http://localhost:5173/
VITE_CLICK_PAYMENT_URL=https://my.click.uz/services/pay

# Tezkor bog'lanish tugmalari (floating contact). Bo'sh qoldirilsa,
# mos tugma umuman ko'rsatilmaydi.
# Masalan: VITE_TELEGRAM_USERNAME=instema_admin (@ belgisisiz)
VITE_TELEGRAM_USERNAME=
# Xalqaro formatda, faqat raqamlar: VITE_WHATSAPP_PHONE=998901234567
VITE_WHATSAPP_PHONE=

# ---- Xavfsizlik (server) ----
# Login tokenlarini imzolash kaliti. Uzun tasodifiy qator bo'lsin. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Render'da render.yaml o'zi yaratadi. Bo'sh bo'lsa, server har safar yangi kalit
# yaratadi va restartdan keyin adminlar qayta login qilishi kerak bo'ladi.
AUTH_SECRET=

# Admin login/paroli. O'rnatilsa, standart "admin / instema2026" akkaunti o'chiriladi.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Ixtiyoriy: API ga faqat shu saytlardan murojaat qilishga ruxsat (vergul bilan).
# Masalan: https://sizning-sayt.vercel.app   (bo'sh bo'lsa hamma saytga ochiq)
CORS_ORIGIN=
